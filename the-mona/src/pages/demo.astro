---
import { Image } from 'astro:assets';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>The Mona Demo</title>
    <style>
      body {
        overflow: hidden;
        
        background: radial-gradient(circle, rgba(59, 14, 104, 1) 0%, rgba(26, 8, 78, 1) 100%);
      }

     

      .mic{
        width: 400px;
        height: 300px;
        position: absolute;
        top: 50%;
        left: 50%;
        z-index: 1;
        box-shadow:
          0 0 60px 20px #823ca6,
          10px 10px 80px 20px #aab3d2,
          -10px -10px 80px 20px #5acee3,
          0 0 60px 10px #f30bf5;
        animation: mono-color-glow 2s linear infinite;
        transform: translate(-50%, -50%);
        transform-origin: center;
      }

      @keyframes mono-color-glow {
    0% {
      background-color: rgba(15, 255, 193, 0.3);
    }
    25% {
      background-color: rgba(126, 15, 255, 0.3);
    }
    50% {
      background-color: rgba(255, 0, 212, 0.3);
    }
    75% {
      background-color: rgba(0, 255, 148, 0.3);
    }
    100% {
      background-color: rgba(15, 255, 193, 0.3);
    }
  }
        
      
    </style>
  </head>

  <body class="bg-gray-900">
    <div class="mic  ">

      <div class="mic-shadow"></div>
    </div>
  </body>
</html>
