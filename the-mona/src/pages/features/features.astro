---
import Layout from '~/layouts/PageLayout.astro';
import Glowcard from '~/components/glowcard.astro';

import '~/assets/styles/glow.css';
import '~/assets/styles/tailwind.css';
---

<Layout>
  <!-- 🌟 Project Section -->
  <section id="project" class="pt-10">
    <Glowcard>
      <div class="max-w-5xl mx-auto px-4 text-center space-y-10">

        <!-- Intro -->
        <div>
          <h2 class="text-5xl font-extrabold mb-3">
            <span class="bg-clip-text text-transparent bg-mona bg-[length:200%_200%] animate-gradient-move">
              The Project
            </span>
          </h2>
          <p class="text-lg font-medium opacity-90">
            A game, a tool, an experience — built for every occasion.
          </p>
        </div>

        <hr class="border-white/10" />

        <!-- Vision -->
        <div class="space-y-3 max-w-3xl mx-auto">
          <p class="text-xs uppercase tracking-widest opacity-60">
            Project vision
          </p>

          <p class="text-base leading-relaxed opacity-90">
            The Mona isn’t just a game — it’s an interactive experience designed to bring people together.
            From high-energy drinking games to relaxed quiz nights or friendly competitions,
            The Mona adapts to the moment.
          </p>

          <p class="text-base leading-relaxed opacity-90">
            With wireless controls and flexible game modes,
            it goes beyond entertainment and becomes a shared experience.
          </p>
        </div>

        <hr class="border-white/10" />

        <!-- Features -->
        <div class="space-y-8">
          <p class="text-xs uppercase tracking-widest opacity-60">
            Features
          </p>

          <div class="grid gap-6 max-w-4xl mx-auto">

            <div>
              <h3 class="text-xl font-bold mb-1">Play your way</h3>
              <p class="text-base opacity-90">
                Drinking games, quizzes, or friendly competitions —
                The Mona adapts to whatever the night becomes.
              </p>
            </div>

            <div>
              <h3 class="text-xl font-bold mb-1">Instant fun</h3>
              <p class="text-base opacity-90">
                Connect to the local WiFi, choose a game in the web app,
                and start playing. No setup, no friction.
              </p>
            </div>

            <div>
              <h3 class="text-xl font-bold mb-1">Wireless freedom</h3>
              <p class="text-base opacity-90">
                Six fully untethered buttons —
                no cables, no clutter, just smooth and chaotic fun.
              </p>
            </div>

            <div>
              <h3 class="text-xl font-bold mb-1">Built to grow</h3>
              <p class="text-base opacity-90">
                New game modes, custom rules, unexpected twists —
                The Mona evolves along with the people using it.
              </p>
            </div>

            <div>
              <h3 class="text-xl font-bold mb-1">DIY & budget-friendly</h3>
              <p class="text-base opacity-90">
                Affordable, open-source, and made for anyone who loves to tweak,
                build, and experiment.
              </p>
            </div>

            <div>
              <h3 class="text-xl font-bold mb-1">Party-ready</h3>
              <p class="text-base opacity-90">
                From casual evenings to unforgettable celebrations —
                The Mona fits right in.
              </p>
            </div>

          </div>
        </div>

        <hr class="border-white/10" />

        <!-- Closing -->
        <div class="space-y-3">
          <p class="text-base leading-relaxed opacity-90">
            The Mona is designed to be flexible, playful,
            and just unpredictable enough to keep things interesting.
          </p>

          <p class="pt-2 text-sm uppercase tracking-widest opacity-70">
            One press. Endless fun.
          </p>
        </div>

      </div>
    </Glowcard>
  </section>
</Layout>
