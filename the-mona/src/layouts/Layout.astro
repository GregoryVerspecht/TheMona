---
import "../styles/tailwind.css";
import monaLogo from '../assets/the-mona.svg';
import Astronav from '~/components/navbar.astro';
//import Header from "@/components/Header.astro";
//import Footer from "@/components/Footer.astro";

const { title = "The Mona" } = Astro.props;
---


<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#111827">
		<title>{title}</title>
		    <!-- Meta Tags SEO -->
			<meta
			name="description"
			content="The mona - One press away from unforgettable fun!"
		  />
		  <meta name="robots" content="index, follow" />
		  <meta
			name="keywords"
			content="The Mona, Mona, drinking game,"
		  />

			<!-- Tabblad -->
			<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

			<!-- iOS homescreen -->
			<link rel="apple-touch-icon" href="/icons/icon-192.png" sizes="192x192" />

			<!-- Android en PWA -->
			<link rel="manifest" href="/manifest.webmanifest" />
			<meta name="theme-color" content="#111827" />


	</head>
	<body class="bg-gray-900 text-white">

			<Astronav closeOnClick>...
				
			  <!-- Navigation -->
			</Astronav>
		

		<main id="main-content" class="relative flex items-center justify-center">
			<slot />
		  </main>
		  
	<script type="module">
			function updateMainHeight() {
			  const navbar = document.getElementById("navbar");
			  const main = document.getElementById("main-content");
		  
			  if (navbar && main) {
				const navHeight = navbar.offsetHeight;
				main.style.minHeight = `calc(100vh - ${navHeight}px)`;
				
			  }
			}
		  
			window.addEventListener("load", updateMainHeight);
			window.addEventListener("resize", updateMainHeight);
			
		  </script>
				
	</body>
	
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		overflow: hidden;
		
	}

</style>
