---
import { Astronav, MenuItems, MenuIcon,  Dropdown, DropdownItems } from "astro-navbar";
import { Image } from 'astro:assets';
import monaLogo from '../assets/the-mona.svg';
---

<header id="navbar" class="lg:flex p-10 gap-10">
    <Astronav>
      <div class="flex w-full items-center justify-between">
        
        <!-- Linkerkant: logo + tekst -->
        <a href="#" class="flex items-center space-x-5">
          <Image
            src={monaLogo}
            alt="The Mona."
            width={40}
            height={40}
            class="mb-1"
          />
          <span class="text-lg font-semibold">The Mona</span>
        </a>
  
        <!-- Rechterkant: navigatie of hamburger -->
        <div class="flex items-center">
          <!-- Hamburger alleen zichtbaar op mobile -->
          <div class="block lg:hidden">
            <MenuIcon class="w-6 h-6 text-gray-800" />
          </div>
  
          <!-- Menu-items alleen zichtbaar op desktop -->
          <MenuItems class="hidden lg:flex ml-4">
            <ul class="flex flex-col lg:flex-row lg:gap-5">
              <li><a href="/">Home</a></li>
              <li><a href="/demo-page">Demo</a></li>
              <li>
                <Dropdown class="group">
                  <button class="flex items-center">
                    <span> Services </span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="3"
                      stroke="currentColor"
                      class="w-3 h-3 mt-0.5 group-open:rotate-180">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
                    </svg>
                  </button>
                  <DropdownItems class="relative">
                    <div class="absolute top-0">
                      <ul>
                        <li>Menu 1</li>
                        <li>Menu 2</li>
                        <li>Menu 3</li>
                      </ul>
                    </div>
                  </DropdownItems>
                </Dropdown>
              </li>
            </ul>
          </MenuItems>
        </div>
      </div>
    </Astronav>
  </header>
  
  