---
import { Image } from 'astro:assets';
import monaLogo from '../assets/the-mona.svg';
---

<div class="relative min-h-screen font-sans overflow-hidden">

  <!-- Achtergrond -->
  <div class="fixed top-0 left-0 w-full h-full z-[-20] bg-gray-900"></div>

  <!-- Glow buiten de kaart -->
  <main class="relative flex items-center justify-center min-h-screen px-4">

    <!-- 🔥 GLOW EFFECT -->
    <div
      class="absolute z-0 rounded-3xl blur-3xl opacity-70
             bg-[linear-gradient(90deg,_#0fffc1,_#7e0fff)]
             bg-[length:200%_200%] animate-gradient-move
             w-[90vw] max-w-md h-[70vh] sm:h-[60vh] will-change-transform"
    ></div>

    <!-- 📦 Kaart met inhoud -->
    <section class="relative z-10 p-10 rounded-2xl bg-gray-800 text-center text-white w-full max-w-sm sm:max-w-md md:max-w-md overflow-hidden">
      
      <!-- Logo -->
      <Image
        src={monaLogo}
        alt="The Mona."
        class="mx-auto mb-6 w-full h-auto"
      />

      <!-- Titel -->
      <h1 class="text-3xl sm:text-5xl md:text-5xl lg:text-6xl font-extrabold leading-tight tracking-tight mb-6 animate-fade-in delay-[400ms]">
        <span class="bg-clip-text text-transparent bg-mona bg-[length:200%_200%] animate-gradient-move">
          The Mona
        </span>
      </h1>

      <!-- Subtitel -->
      <h2 class="text-base sm:text-lg md:text-xl lg:text-2xl font-medium md:font-semibold leading-snug tracking-normal mb-6 animate-fade-in delay-[600ms]">
        <span class="bg-clip-text text-transparent bg-white">
          One press away from unforgettable fun!
        </span>
      </h2>

      <!-- CTA -->
      <div class="flex justify-center gap-4 mt-6 flex-wrap animate-fade-in delay-[800ms]">
        <a
          href="#"
          class="flex items-center gap-2 px-4 py-2 rounded-lg text-white shadow-md hover:opacity-90 transition bg-mona-alt bg-[length:200%_200%] animate-gradient-move"
        >
          <button>Discover the story!</button>
        </a>
      </div>

    </section>
  </main>
</div>
