---
import background from '../assets/background.svg';
import { Image } from 'astro:assets';
import monaLogo from '../assets/the-mona.svg';
---

<div class="relative min-h-screen font-sans overflow-hidden">

  <!-- Geanimeerde achtergrondlaag -->
  <div class="fixed top-0 left-0 w-full h-full bg-gradient-to-br from-gray-900 to-gray-800 "></div>

  <!-- Glow box met inhoud -->
  <main class="flex items-center justify-center min-h-screen px-4">
    <section class="relative inline-block p-10 rounded-2xl bg-[#231515b3] shadow-inner shadow-black text-center text-white w-full w-xl">

      <!-- Glow effect achter de content -->
      <div class="absolute top-0 left-0 right-0 bottom-0 m-auto w-full h-full z-[-1] blur-3xl rounded-2xl scale-[1.3] bg-[linear-gradient(90deg,_#0fffc1,_#7e0fff)] bg-[length:200%_200%] animate-gradient-move"></div>

      <!-- Logo -->
      <Image
        src={monaLogo}
        alt="The Mona."
        class="mx-auto mb-8 w-auto h-auto animate-fade-in delay-[200ms]"
      />

      <!-- Titel -->
      <h1 class="text-5xl md:text-6xl font-bold mb-6 animate-fade-in delay-[400ms]">
        <span class="bg-clip-text text-transparent transition bg-mona bg-[length:200%_200%] animate-gradient-move">
          The Mona
        </span>
      </h1>

      <!-- Subtitel -->
      <h2 class="text-xl font-bold mb-6 animate-fade-in delay-[600ms]">
        <span class="bg-clip-text text-transparent bg-white">
          One press away from unforgettable fun!
        </span>
      </h2>

      <!-- CTA Button -->
      <div class="flex justify-center gap-4 mt-6 flex-wrap animate-fade-in delay-[800ms]">
        <a
          href="#"
          class="flex items-center gap-2 px-4 py-2 rounded-lg text-white shadow-md hover:opacity-90 transition bg-mona-alt bg-[length:200%_200%] animate-gradient-move"
        >
          <button>Discover the story!</button>
        </a>
      </div>
    </section>
  </main>
</div>
