---
import Layout from '~/layouts/Layout.astro';
import Astronav from '~/components/navbar.astro';
---

<Layout title="The Mona Demo">

  
  <!-- Demo content -->
  <div class="mic-wrapper text-center">
    
    <div class="mic-shadow"></div>
    <div class="mic">
      <div class="mic-content">
        
        <a href="/">Take me back!</a>
      </div>
    </div>
  </div>

  <style>
    body {
      background: #1f1b2e;
    }

    .mic-wrapper {
      position: relative;
      width: 300px;
      height: 300px;
      margin: 100px auto;
    }

    .mic-shadow {
      position: absolute;
      inset: 0;
      transform: scale(1.0);
      border-radius: 50%;
      z-index: 0;
      box-shadow:
        10px -55px 30px 15px #823ca6,
        24px -10px 47px 10px #aab3d2,
        -21px -25px 97px 10px #5acee3,
        51px 5px 17px 10px #1b7d8f,
        3px 2px 77px 10px #f30bf5;
      animation: shadow-rotate 2.5s linear infinite;
      transform-origin: center;
    }

    .mic {
      position: relative;
      width: 100%;
      height: 100%;
      border-radius: 50%;
      overflow: hidden;
      z-index: 1;
    }

    .mic-content {
      width: 100%;
      height: 100%;
      background-image: url('https://media.giphy.com/media/70olld6I5WYMpL1ddX/giphy.gif');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 1rem;
      font-weight: bold;
      scale: 1.0;
    }

    .mic-content a {
      padding: 0.5rem 1rem;
      background-color: rgba(0, 0, 0, 0.5);
      border-radius: 12px;
      text-decoration: none;
      color: white;
      transition: background-color 0.3s ease;
    }

    .mic-content a:hover {
      background-color: rgba(0, 0, 0, 0.7);
    }

    @keyframes shadow-rotate {
      from {
        transform: scale(1.0) rotate(0deg);
      }
      to {
        transform: scale(1.0) rotate(360deg);
      }
    }
  </style>
</Layout>
